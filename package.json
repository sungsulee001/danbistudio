{
  "name": "danbistudio",
  "version": "0.1.0",
  "private": true,
  "author": "Danbi Studio",
  "license": "UNLICENSED",
  "description": "Danbi Studio - local-first desktop video editor with FFmpeg and automation workflows",
  "main": "dist-electron/main/electron-app.cjs",
  "scripts": {
    "assets:icons": "node scripts/generate-app-icon.mjs",
    "conti:sheet": "node scripts/pipeline/render-conti-sheet.mjs",
    "conti:serve": "node scripts/pipeline/serve-boards.mjs",
    "dev": "next dev",
    "electron:build": "node scripts/build-electron.mjs",
    "electron:dev": "node scripts/dev-electron.mjs",
    "electron:package": "node scripts/electron-package.mjs --win --x64",
    "electron:package:dir": "node scripts/electron-package.mjs --dir --win --x64",
    "electron:gui-smoke": "node scripts/electron-gui-smoke.mjs",
    "electron:installer:smoke": "node scripts/electron-installer-smoke.mjs",
    "electron:install-smoke": "node scripts/electron-install-smoke.mjs",
    "electron:local-installed-acceptance": "node scripts/electron-local-installed-acceptance.mjs",
    "electron:offline-smoke": "node scripts/electron-offline-smoke.mjs",
    "electron:package:smoke": "node scripts/electron-package-smoke.mjs",
    "electron:release:prepare": "node scripts/prepare-electron-release.mjs",
    "electron:release:acceptance": "node scripts/electron-release-acceptance.mjs",
    "electron:release:handoff": "node scripts/electron-release-handoff.mjs",
    "electron:release:import-evidence": "node scripts/electron-release-import-evidence.mjs",
    "electron:release:manual-acceptance": "node scripts/electron-release-manual-acceptance.mjs",
    "electron:release:final-gate": "node scripts/electron-release-final-gate.mjs",
    "electron:release:status": "node scripts/electron-release-status.mjs",
    "electron:release:verify": "node scripts/electron-release-verify.mjs --profile full",
    "electron:release:verify:core": "node scripts/electron-release-verify.mjs --profile core",
    "electron:smoke": "node scripts/electron-smoke.mjs",
    "electron:start": "npm run electron:build && electron dist-electron/main/electron-app.cjs",
    "editor:extension-sandbox": "node scripts/extension-sandbox.mjs",
    "editor:external-exporter": "node scripts/external-exporter.mjs",
    "editor:headless-render": "node scripts/headless-render.mjs",
    "editor:render-worker": "node scripts/render-worker.mjs",
    "editor:render-worker-daemon": "node scripts/render-worker-daemon.mjs",
    "sample:pack": "node scripts/sample-project-pack.mjs",
    "sample:smoke": "node scripts/sample-project-pack.mjs --verify-render",
    "build": "next build --webpack",
    "start": "next start",
    "architecture:check": "node scripts/check-electron-boundaries.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:render-smoke": "node scripts/render-smoke.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "license:check": "node scripts/check-third-party-compliance.mjs",
    "plugin-package:sign": "node scripts/plugin-package-sign.mjs",
    "plugin-signing:check": "node scripts/plugin-signing-readiness.mjs",
    "plugin-signing:custody-audit": "node scripts/plugin-signing-custody-audit.mjs",
    "plugin-signing:keygen": "node scripts/plugin-signing-keygen.mjs",
    "plugin-signing:rotation-drill": "node scripts/plugin-signing-rotation-drill.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@tanstack/react-query": "^5.60.0",
    "next": "^16.2.9",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "uuid": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.5.0",
    "autoprefixer": "^10.4.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.5.10",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
