    { "id": "H-4", "category": "접속사", "severity": "S2", "threshold": 2, "label": "즉 남발", "patterns": ["\\s즉\\s", "^즉\\s"], "fix": "1회로 제한" },

    { "id": "I-1", "category": "형식명사", "severity": "S2", "threshold": 3, "label": "~인 것이다/한 것입니다 결말", "patterns": ["것입니다[.!?…]?\\s*$", "것이다[.!?…]?\\s*$", "것이었습니다[.!?…]?\\s*$"], "exclude": ["을\\s*것", "의\\s*것"], "exclude_note": "`~았을 것입니다`는 규칙 17 추정 화법, `~의 것이었습니다`는 소유 명사 것 — 둘 다 AI-티가 아니다.", "scope": "sentence", "fix": "평서형으로 직결" },
    { "id": "I-2", "category": "형식명사", "severity": "S2", "threshold": 1, "label": "X은 ~라는 점에 있다", "patterns": ["점에\\s*있"], "fix": "X는 ~다 직설로" },
    { "id": "I-3", "category": "형식명사", "severity": "S2", "threshold": 2, "label": "~다는 뜻이다/의미다", "patterns": ["다는\\s*뜻", "다는\\s*의미", "라는\\s*뜻", "라는\\s*의미"], "fix": "본문에 풀어 쓰기" },
    { "id": "I-4", "category": "형식명사", "severity": "S2", "threshold": 3, "label": "권고형 결말 반복", "patterns": ["해야\\s*할\\s*것", "필요가\\s*있습니다", "바람직합니다"], "fix": "평서·단언으로" },

