    { "id": "SUNNY-2", "category": "Sunny", "severity": "S2", "threshold": 2, "label": "조사 의 연쇄(2회 이상 한 문장)", "scope": "sentence-custom", "custom": "possessive_chain", "min_chain": 4, "fix": "명사구를 풀거나 하나를 뺀다" },
    { "id": "SUNNY-3", "category": "Sunny", "severity": "S2", "threshold": 8, "label": "접미사 들 과다", "patterns": ["[가-힣]{2,}들(?=[\\s은는이가을를의,.])"], "fix": "실제 복수·분포가 아니면 뺀다" },
    { "id": "SUNNY-4", "category": "Sunny", "severity": "S2", "threshold": 6, "label": "의존명사 것 과다", "patterns": ["\\s것[은는이가을를의]", "\\s것입니다", "\\s것이다"], "fix": "술어를 미루는 껍데기면 직결" },
    { "id": "SUNNY-5", "category": "Sunny", "severity": "S2", "threshold": 6, "label": "있는/있다는 완충재", "patterns": ["\\s있는\\s", "있다는\\s"], "fix": "명사 앞 완충재면 뺀다" },
    { "id": "SUNNY-7", "category": "Sunny", "severity": "S2", "threshold": 1, "label": "에게 있어/함에 있어", "patterns": ["에게\\s*있어", "함에\\s*있어", "하는\\s*데\\s*있어", "관계에\\s*있"], "fix": "쉬운 술어·조사로" }
  ]
