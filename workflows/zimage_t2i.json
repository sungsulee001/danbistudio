{
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model: z_image_turbo_bf16" },
    "inputs": { "unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "default" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load Text Encoder: qwen_3_4b (type=lumina2)" },
    "inputs": { "clip_name": "qwen_3_4b.safetensors", "type": "lumina2", "device": "default" }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load VAE: ae.safetensors (Flux VAE)" },
    "inputs": { "vae_name": "ae.safetensors" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "PROMPT (positive) — edit inputs.text" },
    "inputs": {
      "clip": ["2", 0],
      "text": "{STYLE}, night darkness, silhouette of a broken royal palanquin collapsed on the ground, splintered lacquered wooden beams and torn red silk canopy, scattered debris, a single soft shaft of pale moonlight falling from above, ominous stillness, extreme negative space, early Joseon royal sedan chair with brass fittings"
    }
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Negative (ZeroOut — cfg 1.0 ignores negative)" },
    "inputs": { "conditioning": ["4", 0] }
  },
  "6": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": { "title": "ModelSampling shift=3.0" },
    "inputs": { "model": ["1", 0], "shift": 3.0 }
  },
  "7": {
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "RESOLUTION — edit inputs.width/height (1280x720)" },
    "inputs": { "width": 1280, "height": 720, "batch_size": 1 }
  },
  "8": {
    "class_type": "KSampler",
    "_meta": { "title": "SEED — edit inputs.seed (turbo: steps=8, cfg=1.0)" },
    "inputs": {
      "model": ["6", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["7", 0],
      "seed": 20260719,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE Decode" },
    "inputs": { "samples": ["8", 0], "vae": ["3", 0] }
  },
  "10": {
    "class_type": "SaveImage",
    "_meta": { "title": "OUTPUT NAME — edit inputs.filename_prefix" },
    "inputs": { "images": ["9", 0], "filename_prefix": "Danbi_S4_style_test" }
  }
}
