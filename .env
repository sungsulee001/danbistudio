# DanbiStudio Environment Configuration
# StabilityMatrix Path: E:\ai_tool\StabilityMatrix

# ComfyUI Connection
COMFYUI_URL=http://localhost:8188
COMFYUI_WS_URL=ws://localhost:8188/ws

# StabilityMatrix Paths
STABILITY_MATRIX_ROOT=E:/ai_tool/StabilityMatrix
COMFYUI_PACKAGE_PATH=E:/ai_tool/StabilityMatrix/Data/Packages/DanbiStudio-ComfyUI

# ComfyUI Model Paths
COMFYUI_MODELS_CHECKPOINT=E:/ai_tool/StabilityMatrix/Data/Packages/DanbiStudio-ComfyUI/models/checkpoints
COMFYUI_MODELS_DIFFUSION=E:/ai_tool/StabilityMatrix/Data/Packages/DanbiStudio-ComfyUI/models/diffusion_models
COMFYUI_MODELS_UPSCALE=E:/ai_tool/StabilityMatrix/Data/Packages/DanbiStudio-ComfyUI/models/upscale_models
COMFYUI_MODELS_CONTROLNET=E:/ai_tool/StabilityMatrix/Data/Packages/DanbiStudio-ComfyUI/models/controlnet
COMFYUI_OUTPUT=E:/ai_tool/StabilityMatrix/Data/Packages/DanbiStudio-ComfyUI/output

# Workflow Path
WORKFLOWS_DIR=./workflows

# DanbiStudio Output
OUTPUT_DIR=./public/outputs
TEMP_DIR=./public/temp

# Database
DATABASE_URL=file:./prisma/dev.db

# Job Processing
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=300
CLEANUP_OLD_RESULTS_DAYS=30

# Development
NODE_ENV=development
PORT=3000
